---
// Feature Widgets
import DataWidget from "@/components/featureWidgets/DataWidget.astro";
import ClonesWidget from "@/components/featureWidgets/ClonesWidget.astro";
import TeamWorkWidget from "@/components/featureWidgets/TeamWorkWidget.astro";
import ShortcutsWidget from "@/components/featureWidgets/ShortcutsWidget.astro";
import IntegrationsWidget from "@/components/featureWidgets/IntegrationsWidget.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Boats from "@/images/assets/lobster-boat.webp"
import {Image} from "astro:assets";
import Rockport from "@/images/assets/rockport-harbor.webp";
import House from "@/images/assets/houses.jpg";

---

<section id="issues">
  <Wrapper variant="standard" class="py-12">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4 md:items-end">
      <div>
        <Text
          tag="h1"
          variant="displayLG"
          class="text-navy-blue mb-6 font-serif"
        >
          Issues that matter to Sarah
        </Text>
      </div>
    </div>
    <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-6">
      <div class="relative p-4 overflow-hidden lg:col-span-2 lg:p-8 bg-light-blue">
        <div class="relative flex flex-col justify-start h-full">
          <div>
            <Text tag="h3" variant="textXL" class="font-medium text-content-gray">
              Commerce
            </Text>
            <Text tag="p" variant="textLG" class="mt-2 text-base-600">
              Supporting the variety of business types that exist in Cape Ann.
            </Text>
          </div>
          <div class="relative mt-12 -mr-16">
              <Image
                      width={2000}
                      height={2000}
                      src={Boats}
                      alt="#_"
                      loading="eager"
                      decoding="async"
                      class="w-full"
              />
          </div>
        </div>
      </div>
      <div class="relative p-4 overflow-hidden lg:col-span-2 lg:p-8 bg-light-blue">
        <div class="relative flex flex-col justify-start h-full">
          <div>
            <Text tag="h3" variant="textXL" class="font-medium text-content-gray">
              Tourism
            </Text>
            <Text tag="p" variant="textLG" class="mt-2 text-base-600">
              Sharing Cape Ann in a manner that supports local interests.
            </Text>
          </div>
          <div class="relative mt-12 -mr-16">
              <Image
                      width={2000}
                      height={2000}
                      src={Rockport}
                      alt="#_"
                      loading="eager"
                      decoding="async"
                      class="w-full"
              />
          </div>
        </div>
      </div>
      <div
        class="relative p-4 overflow-hidden lg:col-span-2 lg:p-8 bg-light-blue"
      >
        <div class="relative flex flex-col justify-start h-full">
          <div>
            <Text tag="h3" variant="textXL" class="font-medium text-content-gray">
                Housing
            </Text>
            <Text tag="p" variant="textLG" class="mt-2 text-base-600">
              Ensuring that Cape Ann stays a sustainable place to live for future generations.
            </Text>
          </div>
          <div class="relative mt-12 -mr-16">
              <Image
                      width={2000}
                      height={2000}
                      src={House}
                      alt="#_"
                      loading="eager"
                      decoding="async"
                      class="w-full"
              />
          </div>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
