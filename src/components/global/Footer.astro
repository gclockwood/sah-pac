---
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Button from "@/components/fundations/elements/Button.astro";
const footerLinks = [
    {
        title: "Navigation",
        links: [
            {href: "/about-sarah", label: "About Sarah"},
            {href: "/issues", label: "Issues"},
            {href: "/home", label: "Links"},
            {href: "/system/buttons", label: "Buttons"},
            {href: "/system/typography", label: "Typography"},
        ],
    },
    {
        title: "Show Your Support",
        links: [
            {href: "/donate", label: "Donate"},
            {href: "/forms/yard-sign", label: "Get a Yard Sign"},
        ],
    },
    {
        title: "See More",
        links: [
            {
                href: "https://facebook.com/intent/",
                label: "Facebook",
            },
            {
                href: "/news", label: "Sarah in the News",
            }
        ],
    },
];
---

<footer class="relative bg-navy-blue">
    <Wrapper variant="standard" class="py-8">
        <div
                class="items-start pt-12 mt-12 tracking-tight grid grid-cols-1 lg:grid-cols-2 gap-x-8 gap-y-24"
        >
            <div class="flex flex-col justify-between h-full order-2 lg:order-1">
                <div class="flex-row justify-center items-center bg-base-50 p-5 mt-auto">
                    <div class="p-3 border-2 border-navy-blue">
                        <Text
                                tag="h1"
                                variant="textMD"
                                class="text-content-gray font-bold text-center">
                            - PAID FOR BY THE COMMITTEE TO ELECT SARAH WILKINSON -
                        </Text>

                    </div>
                </div>

            </div>
            <div class="flex flex-col justify-between h-full p-8 bg-base-50 order-1 lg:order-2">
                <Text
                        tag="p"
                        variant="displaySM"
                        class="md:max-w-sm text-base-800 text-balance"
                >Stay up to date with Sarah's campaign.
                </Text
                >

                <div>
                    <form id="newsletter-form" class="mt-2 space-y-4" aria-label="Newsletter Signup Form">
                        <div id="newsletter-success" class="hidden p-3 mb-2 text-sm text-green-700 bg-green-100 border border-green-400 rounded">
                            Thank you! You've been subscribed successfully.
                        </div>
                        <div id="newsletter-error" class="hidden p-3 mb-2 text-sm text-red-700 bg-red-100 border border-red-400 rounded">
                            There was an error subscribing. Please try again.
                        </div>
                        <div>
                            <label for="footer-email" class="sr-only">Email address</label>
                            <input
                                    type="email"
                                    id="footer-email"
                                    name="email"
                                    placeholder="name@email.com"
                                    required
                                    class="w-full text-lg bg-white border-transparent outline-none h-14 text-base-700 placeholder-base-400 focus:ring-inset focus:ring-base-800 focus:border-base-800"
                            />
                        </div>
                        <Button
                                id="newsletter-submit"
                                type="submit"
                                size="xl"
                                variant="default"
                                class="w-full"
                        >
                            <span id="newsletter-button-text">Signup</span>
                        </Button>
                    </form>
                </div>
            </div>
        </div>
    </Wrapper>
</footer>

<script>
  const newsletterForm = document.getElementById('newsletter-form') as HTMLFormElement;
  const newsletterSubmit = document.getElementById('newsletter-submit') as HTMLButtonElement;
  const newsletterButtonText = document.getElementById('newsletter-button-text') as HTMLSpanElement;
  const newsletterSuccess = document.getElementById('newsletter-success') as HTMLDivElement;
  const newsletterError = document.getElementById('newsletter-error') as HTMLDivElement;

  if (newsletterForm) {
    newsletterForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Hide previous messages
      newsletterSuccess.classList.add('hidden');
      newsletterError.classList.add('hidden');

      // Disable button and show loading state
      newsletterSubmit.disabled = true;
      newsletterButtonText.textContent = 'Subscribing...';

      // Collect form data
      const formData = new FormData(newsletterForm);
      const data = {
        formType: 'newsletter',
        email: formData.get('email'),
      };

      try {
        // Replace with your Cloudflare Worker URL
        const response = await fetch('https://postmaster.wilkinsonforcapeann.com/newsletter', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          const result = await response.json();
          // Show success message
          newsletterSuccess.classList.remove('hidden');
          newsletterForm.reset();
        } else {
          const errorData = await response.json();
          throw new Error(errorData.error || 'Subscription failed');
        }
      } catch (error) {
        // Show error message
        newsletterError.classList.remove('hidden');
        console.error('Error subscribing:', error);
      } finally {
        // Re-enable button
        newsletterSubmit.disabled = false;
        newsletterButtonText.textContent = 'Signup';
      }
    });
  }
</script>
