---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout>
    <section>
        <Wrapper variant="standard" class="pt-48 pb-8">
            <div class="max-w-xl mx-auto">
                <Text
                        tag="h1"
                        variant="displayMD"
                        class="max-w-sm text-content-gray text-balance leading-relaxed"
                >
                    Request A Yard Sign to Show Your Support
                </Text>

                <form class="mt-4 space-y-4" aria-label="Book a Demo Form">
                    <div>
                        <label for="name" class="sr-only">Full Name</label>
                        <Text tag="h2" variant="headline" class="max-w-sm text-content-gray">Name:</Text>
                        <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="John Doe"
                                required
                                class="w-full text-lg border-transparent outline-none bg-base-100 h-14 text-base-700 placeholder-base-400 focus:ring-inset focus:ring-base-800 focus:border-base-800 focus:bg-white"
                        />
                    </div>
                    <div>
                        <label for="email" class="sr-only">Email Address</label>
                        <Text tag="h2" variant="headline" class="max-w-sm text-content-gray">Email Address:</Text>

                        <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="you@example.com"
                                required
                                class="w-full text-lg border-transparent outline-none bg-base-100 h-14 text-base-700 placeholder-base-400 focus:ring-inset focus:ring-base-800 focus:border-base-800 focus:bg-white"
                        />
                    </div>
                    <div>
                        <label for="address" class="sr-only">Street Address</label>
                        <Text tag="h2" variant="headline" class="max-w-sm text-content-gray">Street Address:</Text>
                        <textarea
                                id="address"
                                name="address"
                                placeholder="123 Main St \nCape Ann, MA \n019XX"
                                rows="4"
                                class="w-full text-lg border-transparent outline-none bg-base-100 text-base-700 placeholder-base-400 focus:ring-inset focus:ring-base-800 focus:border-base-800"
                        ></textarea>
                    </div>
                    <Button
                            size="xl"
                            variant="default"
                            type="submit"
                            class="flex items-center w-full gap-2 bg-navy-blue"
                    >
                        Request A Sign
                    </Button>
                </form>
                <Text tag="p" variant="textXS" class="mt-4 text-base-500">
                    Fill out the form and we'll get back to you soon about a pickup or drop-off.
                </Text>
            </div>
        </Wrapper>
    </section>
</BaseLayout>

<script>
    const form = document.getElementById('yard-sign-form') as HTMLFormElement;
    const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
    const buttonText = document.getElementById('button-text') as HTMLSpanElement;
    const successMessage = document.getElementById('success-message') as HTMLDivElement;
    const errorMessage = document.getElementById('error-message') as HTMLDivElement;

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Hide previous messages
        successMessage.classList.add('hidden');
        errorMessage.classList.add('hidden');

        // Disable button and show loading state
        submitButton.disabled = true;
        buttonText.textContent = 'Submitting...';

        // Collect form data
        const formData = new FormData(form);
        const data = {
            name: formData.get('name'),
            email: formData.get('email'),
            address: formData.get('address'),
        };

        try {
            // Replace with your Cloudflare Worker URL
            const response = await fetch('https://postmaster.wilkinsonforcapeann.com/submit', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(data),
            });

            if (response.ok) {
                // Show success message
                successMessage.classList.remove('hidden');
                form.reset();
            } else {
                throw new Error('Submission failed');
            }
        } catch (error) {
            // Show error message
            errorMessage.classList.remove('hidden');
            console.error('Error submitting form:', error);
        } finally {
            // Re-enable button
            submitButton.disabled = false;
            buttonText.textContent = 'Request A Sign';
        }
    });
</script>
